# --- Database ---
DATABASE_URL=postgresql://shindig:shindig@localhost:5433/shindig

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=
# 32 random bytes, base64. Encrypts Pinterest tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
UPLOAD_DIR=./uploads

# --- Vision ---
# Without a key, Shindig falls back to palette-only analysis (no style read).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Pinterest (developers.pinterest.com) ---
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback

# --- Web ---
API_INTERNAL_URL=http://localhost:4000
